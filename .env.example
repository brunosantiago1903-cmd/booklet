# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta (service role). Só no servidor; nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# E-mails autorizados a usar o app, separados por vírgula.
ALLOWED_EMAILS=voce@exemplo.com,esposa@exemplo.com

# API da Anthropic (console.anthropic.com) para ler comprovantes e sugerir categorias.
ANTHROPIC_API_KEY=sk-ant-...

# Chave de 32 bytes em base64 para criptografar o client secret da Pluggy.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Segredo que a Vercel envia no header Authorization do cron diário.
CRON_SECRET=
