# Obtenha o token com @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Chave da API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_chave_aqui

# (Opcional) IDs de usuários Telegram permitidos, separados por vírgula.
# Deixe em branco para permitir todos os usuários.
# Descubra seu ID com @userinfobot no Telegram.
ALLOWED_USER_IDS=123456789,987654321

# (Opcional) Diretório de trabalho para operações de arquivo.
# Se não configurado, usa o diretório atual.
# WORKING_DIR=/home/user/meu_projeto
