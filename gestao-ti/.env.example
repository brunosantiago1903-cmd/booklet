# ===== Banco de dados (Postgres no Docker) =====
POSTGRES_PASSWORD=troque-esta-senha
# Para rodar a app FORA do Docker (npm run dev), use localhost:
# DATABASE_URL=postgres://postgres:troque-esta-senha@localhost:5432/gestao

# ===== Segredo da sessão (login) — gere uma chave longa e aleatória =====
# Ex.: openssl rand -base64 32
APP_SECRET=troque-por-uma-chave-bem-aleatoria

# ===== Web Push (notificação no navegador/PWA) =====
# Gere com: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:brunosantiago1903@gmail.com

# ===== WhatsApp Cloud API (Meta) — opcional, pode deixar vazio no início =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===== URL pública do app =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Produção (HTTPS via Caddy) =====
# Domínio que aponta para este servidor. Necessário para push fora do localhost.
DOMAIN=ti.morretes.pr.gov.br
