# ===== Supabase (Banco de dados + Login) =====
# Crie um projeto em https://supabase.com e copie de Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Chave secreta (service role) — use SOMENTE no servidor, nunca exponha no cliente
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ===== Web Push (notificação no navegador/PWA) =====
# Gere com: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:brunosantiago1903@gmail.com

# ===== WhatsApp Cloud API (Meta) — opcional, pode deixar vazio no início =====
# https://developers.facebook.com/ > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# URL pública do app (usada em links de notificação)
NEXT_PUBLIC_APP_URL=http://localhost:3000
