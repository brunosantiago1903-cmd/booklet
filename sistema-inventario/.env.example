# Copie para .env e edite os valores antes de subir o Docker:
#   cp .env.example .env

# Segredo de assinatura dos tokens JWT — use um valor longo e aleatório, ex.:
#   openssl rand -hex 32
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Chave compartilhada do agente de telemetria (recomendado).
# Se preenchida, configure o mesmo valor em agente/install.bat (AGENT_KEY).
AGENT_KEY=

# Administrador criado automaticamente na primeira subida do container
ADMIN_EMAIL=admin@prefeitura.gov.br
ADMIN_SENHA=TroqueEstaSenha
ADMIN_NOME=Administrador

# Retenção do histórico de telemetria em dias (0 = nunca apagar).
# A limpeza roda sozinha uma vez por dia.
TELEMETRIA_RETENCAO_DIAS=90

# Token do túnel Cloudflare (painel Zero Trust > Networks > Tunnels).
# Usado apenas com: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
