APP_NAME="SISDC Morretes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost
APP_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL + PostGIS
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sisdc
DB_USERNAME=sisdc
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Sanctum (SPA/PWA interno)
SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_DOMAIN=localhost
